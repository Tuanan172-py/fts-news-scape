users/output/
# Cảnh báo entity nhập sai (auto) — KHÔNG commit
users/subscriptions/_unknown/
users/input/*/_unknown.txt
# GIỮ commit: users/subscriptions/*.csv, users/subscriptions/manifest.yaml, users/subscriptions/_template_news.csv


# Runtime data
logs/
