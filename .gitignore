desktop.ini
**/desktop.ini
~$*.xlsx

# Output per-user hằng ngày (sinh bởi write_user_output.py) — KHÔNG commit
users/output/
# Cảnh báo entity nhập sai (auto) — KHÔNG commit
users/input/*/_unknown.txt
# GIỮ commit: users/input/<name>/entities.xlsx, users/input/manifest.yaml, users/template/*


# Runtime data
logs/
data/*.db
data/*.db-wal
data/*.db-shm
data/raw/
data/dedup_cache.json
data/notifications/
data/exports/
# Handoff & pipeline artifacts (tái sinh được — KHÔNG commit)
# task-packets L1 + bóc tách (l1_route.py / agent_export.py)
data/agent_tasks/
# output agent bóc tách nộp về
data/agent_outputs/
# output agent L1 nộp về
data/agent_outputs_l1/
# Silver (dẫn xuất Bronze qua derive)
data/silver/
# work-package cho handoff
data/work_packages/
# Bronze raw HTML (nặng — tái scrape được)
data/raw_html/

# Harness Durable SQLite
harness.db*

# Python & Environment
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
