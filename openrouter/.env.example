# ==========================================
# OpenRouter & 9Router Environment Variables
# ==========================================

# OpenRouter API Key (Co nap toi thieu $10 de duy tri quota 1.000 req/ngay cho free models)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Google Gemini AI Studio API Key (Free tier tu https://aistudio.google.com)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# 9Router Local Gateway Configuration
ROUTER_BASE_URL=http://localhost:20128/v1
ROUTER_API_KEY=sk-9router-local
DEFAULT_STEALTH_MODEL=stealth/space-bunny-alpha
FALLBACK_MODEL=google/gemini-2.0-flash-exp:free
