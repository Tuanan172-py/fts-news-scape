#!/bin/sh
# News-Scape Git Pre-Commit Hook (Mechanical Enforcement)
# Delegates from git dispatcher; runs quality gates on current branch

PYTHON="${NEWS_SCAPE_PYTHON:-C:/venvs/news-scape/Scripts/python.exe}"
if [ ! -f "$PYTHON" ]; then
    PYTHON="python"
fi

echo "🔍 [GIT HOOK] Kiem tra chat luong code va ve sinh repo..."
"$PYTHON" scripts/harness_cli.py git verify
if [ $? -ne 0 ]; then
    echo "❌ [GIT HOOK FAILED] Harness git verify that bai. Khong the commit!"
    exit 1
fi

# Same whitespace rules as the fpa-toolkit hooks (trailing whitespace, final newline),
# so packages/news stays byte-identical to this repo across satellite syncs.
if ! git diff --cached --check; then
    echo "❌ [GIT HOOK FAILED] Khoang trang cuoi dong hoac dong trong o cuoi tep."
    exit 1
fi
NO_EOL=$(git diff --cached --name-only --diff-filter=ACMR -z | while IFS= read -r -d '' f; do
    if git diff --cached --numstat -- "$f" | grep -qv '^-'; then
        [ -n "$(git cat-file -p ":$f" | tail -c 1)" ] && echo "$f"
    fi
done)
if [ -n "$NO_EOL" ]; then
    echo "❌ [GIT HOOK FAILED] Thieu newline cuoi tep:"
    echo "$NO_EOL"
    exit 1
fi

if [ -f scripts/knowledge.py ]; then
    "$PYTHON" scripts/harness_cli.py doc lint --staged
    if [ $? -ne 0 ]; then
        echo "❌ [GIT HOOK FAILED] Tai lieu tri thuc vi pham hop dong (doc lint --staged)."
        exit 1
    fi

    "$PYTHON" scripts/harness_cli.py doc index --check
    if [ $? -ne 0 ]; then
        echo "❌ [GIT HOOK FAILED] docs/INDEX.md bi lech (doc index --check). Chay 'harness_cli.py doc index' de dong bo!"
        exit 1
    fi
fi

if [ -f project/scripts/docs/build_diagrams.py ]; then
    (cd project && "$PYTHON" scripts/docs/build_diagrams.py --check)
    if [ $? -ne 0 ]; then
        echo "❌ [GIT HOOK FAILED] Diagrams bi cu (build_diagrams.py --check). Chay 'cd project && python scripts/docs/build_diagrams.py'!"
        exit 1
    fi
fi

echo "✅ [GIT HOOK PASSED] Code, tai lieu va diagram deu hop le."
exit 0
