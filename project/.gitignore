# Handoff & pipeline artifacts (tái sinh được — KHÔNG commit)
data/agent_tasks/         # task-packets L1 + bóc tách (l1_route.py / agent_export.py)
data/agent_outputs/       # output agent bóc tách nộp về
data/agent_outputs_l1/    # output agent L1 nộp về
data/silver/              # Silver (dẫn xuất Bronze qua derive)
data/work_packages/       # work-package cho handoff
data/raw_html/            # Bronze raw HTML (nặng — tái scrape được)
