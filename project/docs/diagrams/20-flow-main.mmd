%% title: Main data flow from source to analyst
%% desc: One article passes through four stages, one per layer group.
flowchart LR
  subgraph S1["L1 Capture"]
    A1["News source"] --> A2["Scraper"] --> A3[("discovered_urls")] --> A4[("Bronze")] --> A5[("monocle.db")]
  end
  subgraph S2["L2 Silver"]
    B1["rederive every 30 minutes"] --> B2["Silver"] --> B3["change_detect"] --> B4[("work_items")]
  end
  subgraph S3["L3 Article Lane"]
    C1["pack, batches of 50"] --> C2[["article-processor"]] --> C3["expand"] --> C4["DoD"] --> C5["coverage of at least 90%"]
  end
  subgraph S4["L4 Delivery"]
    D1["route by watchlist"] --> D2[("xlsx per person")] --> D3["publish_day after 01:00"] --> D4[("SharePoint Parquet")] --> D5(["Analyst"])
  end
  A5 -.-> B1
  B4 --> C1
  C5 -->|"pass"| D1
  classDef gate fill:#ffffff,stroke:#111111,stroke-dasharray:4 3
  class C4,C5 gate
