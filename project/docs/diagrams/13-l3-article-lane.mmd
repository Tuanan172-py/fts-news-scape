%% title: L3 Article Lane (the only analysis path)
%% desc: One wave from article_run to verify, including repair and finish.
flowchart TB
  A["article_run.py<br/>manual.begin locks one wave per lane"] --> B["prepare<br/>build_article_prefix --check, article_pack"]
  B --> C[("packets task.json, map.json,<br/>wave.json, conductor.ts")]
  C --> D[["article-processor<br/>agy, opencode run, OpenRouter, DSH agent_article"]]
  D --> E["agent_outputs_article/*.output.json"]
  E -->|"missing records"| R["--repair<br/>repackage the missing part, at most 2 rounds"] --> D
  E --> F["--finish: article_expand<br/>validate and cross-check with the matcher"]
  F --> G["DoD ingest<br/>l1_ingest, agent_ingest"]
  G --> H["verify: coverage of at least 90%<br/>in both l1_outputs and agent_outputs"]
  H -->|"pass"| I["token_ledger in harness.db"] --> J["handoff<br/>HANDOFF-latest.md"]
  H -->|"fail"| P["PARKED, rerun with one command"]
  classDef ok fill:#ffffff,stroke:#111111,stroke-width:3px
  classDef bad fill:#ffffff,stroke:#111111,stroke-dasharray:1 3,stroke-width:2px
  class J ok
  class P bad
  classDef gate fill:#ffffff,stroke:#111111,stroke-dasharray:4 3
  class G,H gate
