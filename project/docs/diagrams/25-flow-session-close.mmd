%% title: Closing a harness session (record, do not block)
%% desc: session close records verify, push and friction in the trace; only a passing verify grants proof.
flowchart TB
  S["session close --story ID --push"] --> V["run the story's verify command"]
  V --> VR["Verify passed?"]
  VR -->|"yes"| OK["story = implemented<br/>unit_proof = 1"]
  VR -->|"no"| FAIL["record the failure in the trace<br/>story keeps its state"]
  FAIL --> STR["--strict given?"]
  STR -->|"yes"| AB["stop"]
  STR -->|"no"| CM
  OK --> CM["commit tracked files<br/>new files need git add first"]
  CM --> PU["push to fpa and origin"]
  PU --> TR[("harness.db trace<br/>outcome = completed or partial")]
  TR --> SL["SESSION-LATEST.md"]
  classDef warn fill:#ffffff,stroke:#111111,stroke-dasharray:4 3
  class FAIL,CM warn
  classDef gate fill:#ffffff,stroke:#111111,stroke-dasharray:4 3
  class STR,VR gate
