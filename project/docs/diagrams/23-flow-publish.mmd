%% title: Publishing and consumption (the only canonical path)
%% desc: publish.py calls publish_day, one way and sandbox only.
sequenceDiagram
  autonumber
  participant DM as ops_daemon publish_tick
  participant PB as publish.py
  participant PD as publisher.publish_day
  participant SP as SharePoint FRA_DataIngestion
  participant LC as lakehouse_cli verify
  participant AN as Analyst (plugin)
  DM->>PB: after 01:00, for yesterday
  PB->>PD: publish_day(closed day)
  PD->>PD: refuse the official FRA site
  PD->>SP: write to staging, then .partial, then replace without overwriting
  PD->>SP: _manifest/date.json and latest.json
  LC->>SP: audit the SHA-256 hashes in the manifest
  AN->>SP: DuckDB reads parquet/articles
  Note over PD,SP: Historical backfill uses publish.py --from and --to (US-038)
