%% title: L2 Silver normalization and story clusters
%% desc: From meta.json to work_items, with change detection and story clustering.
flowchart LR
  M["meta.json and raw"] --> SB["SilverBuilder.build"] --> SQ["Valid silver-v1?"]
  SQ -->|"no"| H1[("held, silver_failures")]
  SQ -->|"yes"| FP["SimHash64 and DOM signature"] --> CD["change_detect<br/>NEW, UNCHANGED, CONTENT_CHANGED,<br/>TEMPLATE_DRIFT, SELECTOR_BROKEN"]
  CD --> VER[("article_versions<br/>append only")]
  VER --> PK["WorkPackageBuilder"] --> PQ["Valid work-package-v1?"]
  PQ -->|"no or drift"| H2[("held")]
  PQ -->|"yes"| WI[("work_items = pending")]
  VER --> SCL["story_cluster<br/>verbatim copies inherit the result, held 48 hours"]
  SCL --> SG["analytics/signals<br/>signal_daily, entity_links"]
  WI -->|"claimed, done, failed"| NXT["Article Lane"]
  classDef held fill:#ffffff,stroke:#111111,stroke-dasharray:4 3
  class H1,H2 held
  classDef gate fill:#ffffff,stroke:#111111,stroke-dasharray:4 3
  class PQ,SQ gate
