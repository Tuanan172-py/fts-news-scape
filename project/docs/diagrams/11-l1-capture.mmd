%% title: L1 Thu thập trọn vẹn (Bronze)
%% desc: Một chu kỳ capture từ trang danh mục tới Bronze và bài trong DB.
flowchart LR
  T["APScheduler tick 10 phút"] --> RC["Orchestrator.run_cycle"] --> SC["scraper theo nguồn"]
  SC --> PG["fetch_list<br/>watermark, tối đa 8 trang"]
  PG --> LD[("discovered_urls<br/>ghi TRƯỚC mọi bộ lọc")]
  LD --> EX["seen_articles<br/>trùng kỹ thuật?"]
  EX -->|"alias"| AL[("url_aliases")]
  EX -->|"mới"| CAP["CaptureMixin<br/>robots, backoff, fetch"]
  CAP --> RS[("RawStore.save<br/>byte-exact, SHA-256")]
  RS --> ART[("articles trong monocle.db")]
  ART --> CSV["CSV và WAL checkpoint"]
  RC --> RE["capture_reconcile<br/>sitemap lệch >2% một ngày là ĐỎ"]
  RE --> BF["backfill_deferred<br/>tải bù bài hoãn"]
  classDef store fill:#e9e9e9,stroke:#111111
  class LD,AL,RS,ART store
  classDef gate fill:#ffffff,stroke:#111111,stroke-dasharray:4 3
  class EX gate
