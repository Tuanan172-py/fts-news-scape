%% title: Autonomy levels L0 and L1
%% desc: Only two levels exist; L2 and L3 are refused (ADR-0026.D4).
flowchart LR
  L0["L0<br/>stopped and locked; measures and reports only"]
  L1["L1<br/>a mandate with a per-wave article cap<br/>renews itself while the system is healthy"]
  L0 -->|"/level L1 n, then Confirm<br/>n from 1 to 500"| L1
  L1 -->|"/level L0, /stop,<br/>expiry, or the system is unhealthy"| L0
  RF["/level L2 or /level L3<br/>is refused and the current level is kept<br/>Use /level L1 followed by the article count"]
  RL["An unknown level in the order file is read as L0<br/>While the daemon runs at L1, nobody opens a wave by hand"]
  classDef no fill:#ffffff,stroke:#111111,stroke-dasharray:1 3,stroke-width:2px
  class RF no
