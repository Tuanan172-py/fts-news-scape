# Copy file này thành config/secrets.yaml (gitignored) và điền giá trị thật.
# KHÔNG commit secrets.yaml.

# FireAnt Bearer token — lấy từ DevTools (F12) → Network → request tới
# restv2.fireant.vn → header "Authorization: Bearer <token>".
# Token hết hạn → scraper tự disable + ERROR log; cập nhật thủ công (Phase 1).
fireant_token: "PASTE_BEARER_TOKEN_HERE"
